# API locale pour éviter d'envoyer les tests vers le backend de production
VITE_API_BASE_URL=http://localhost:3000/api

# Domaine public Vercel, sans protocole
VITE_APP_DOMAIN=votre-app-frontend.vercel.app

# Hôtes HTTPS autorisés pour l’envoi automatique des identifiants Hotspot
VITE_MIKROTIK_LOGIN_HOSTS=hotspot.exemple.com
